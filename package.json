{
  "name": "battle-map-curator",
  "version": "1.0.0",
  "module": "src/server.tsx",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "bunx @tailwindcss/cli -i styles/app.css -o public/app.css --minify",
    "dev": "bun run build && bun run --watch src/server.tsx",
    "migrate": "bun run src/db/migrate.ts",
    "start": "bun run build && bun run src/server.tsx",
    "test": "bun run build && bun test --no-env-file",
    "typecheck": "bunx tsc --noEmit",
    "user": "bun run cli/user.ts"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "sharp": "^0.35.5"
  }
}
