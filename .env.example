# Battle Map Curator configuration.
# Copy to `.env` and adjust. Bun loads `.env` automatically.
# Every value below is optional; the defaults shown are what the app uses.

# --- Server ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# --- Storage ---
# Both paths may be relative (resolved against the working directory) or absolute.
DATABASE_PATH=./data/bmc.sqlite
# Full-resolution maps live here. This directory MUST NOT be inside ./public —
# it is served only through authenticated routes.
IMAGE_DIR=./data/images

# --- Uploads ---
# Accepts a byte count or a KB/MB/GB suffix.
MAX_UPLOAD_BYTES=25MB
# Guards against decompression bombs: refuses images with more pixels than this.
MAX_IMAGE_PIXELS=100000000
# Longest edge of a generated thumbnail, in pixels.
THUMB_SIZE=400
# Thumbnails are a derived preview and always lossy, whatever IMAGE_QUALITY says.
# They are written in IMAGE_FORMAT so a map and its thumbnail share one format.
THUMB_QUALITY=90

# --- Image storage ---
# How an uploaded map is re-encoded to be stored. Every map records the format it
# was stored in, so changing this affects new uploads only — maps already in the
# library keep their own files and are served as what they are.
# One of: webp, png, jpeg (jpg is accepted for jpeg).
IMAGE_FORMAT=webp
# 1-100. Applies to JPEG always, to WEBP unless IMAGE_LOSSLESS is set, and to PNG
# only below 100, where it switches on palette quantisation — the one way PNG can
# trade quality for size.
IMAGE_QUALITY=95
# WEBP only, and the only setting that makes storage bit-exact. Quality 100 is
# visually indistinguishable but does still re-encode; PNG is lossless whatever
# this says, and setting it with IMAGE_FORMAT=jpeg refuses to start.
IMAGE_LOSSLESS=false

# --- Duplicate detection ---
# How many of a 64-bit perceptual hash's bits two maps may differ on and still
# be reported as substantially similar. Lower is stricter; 0 means only images
# that reduce to an identical fingerprint are matched.
FINGERPRINT_MAX_DISTANCE=10
# An upload that matched an existing map waits here for the admin to confirm or
# discard it. Abandoned ones are swept, files and all, after this long.
PENDING_UPLOAD_TTL_SECONDS=3600

# --- Higher-resolution search ---
# After an upload, look for a larger copy of the same image on the web and offer
# to swap it in. Off by default; `serpapi` is the only provider implemented.
#
# This is the one feature that shows a full-resolution map to something other
# than a signed-in user: the search provider fetches the staged image itself, so
# while a search is running that one unsaved image is readable at an unguessable
# URL. The upload form carries a checkbox — ticked by default — and unticking it
# skips the search entirely, so nothing is ever exposed.
WEB_SEARCH_PROVIDER=none
# From serpapi.com. The free plan allows 250 searches a month.
SERPAPI_KEY=
# Where the provider will fetch the staged image from. Must be a bare https
# origin reachable from the public internet — HOST and PORT describe the socket
# this process binds, which is not the same thing behind a reverse proxy.
# Required, and validated at boot, whenever a provider is set.
PUBLIC_BASE_URL=
# How long to wait for the provider before giving up and saving the map anyway.
# A search that has not answered by now has cost more than it is worth.
WEB_SEARCH_TIMEOUT_MS=6000
# How many alternatives to offer at once.
WEB_SEARCH_MAX_CANDIDATES=5
# How much bigger a copy must be to be worth offering, as a fraction of the
# uploaded pixel count. 0.2 means it must have at least 20% more pixels.
WEB_SEARCH_MIN_PIXEL_GAIN=0.2
# Ceiling on an image downloaded from the web. Accepts a KB/MB/GB suffix.
WEB_SEARCH_MAX_DOWNLOAD_BYTES=25MB
# Uploads already larger than this are not searched for: nothing worth finding.
WEB_SEARCH_SKIP_ABOVE_PIXELS=20000000
# Searches allowed per rolling month. Refills continuously rather than resetting
# on a date, so a busy day cannot strand the rest of the month.
WEB_SEARCH_MONTHLY_LIMIT=250
# How long a staged image stays fetchable by the provider. Minutes, not hours.
WEB_SEARCH_SHARE_TTL_SECONDS=300

# --- Browsing ---
PAGE_SIZE=24

# --- Automatic grid detection (not yet implemented; reserved) ---
GRID_MAX_UPSCALE=2.0
GRID_MIN_CONFIDENCE=2.5
GRID_MIN_PX=16
GRID_MAX_PX=512
GRID_ANALYSIS_MAX_DIM=2400

# --- Sessions ---
# Absolute lifetime of a session, and how long it may sit idle before expiring.
SESSION_TTL_SECONDS=1209600
SESSION_IDLE_SECONDS=259200
# Set to false ONLY when running over plain HTTP (e.g. a LAN test box).
# Leaving this true over HTTP means the session cookie is never sent back.
COOKIE_SECURE=true
# Enable when running behind a reverse proxy so X-Forwarded-For is honoured.
TRUST_PROXY=false

# --- Accounts ---
MIN_PASSWORD_LENGTH=12
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
